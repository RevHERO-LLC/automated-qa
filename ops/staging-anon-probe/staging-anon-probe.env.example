# /etc/revhero/staging-anon-probe.env   (chmod 0600; install.sh writes a skeleton — secrets are NOT in this repo)
#
# REQUIRED: the probe exits 2 (unit FAILED) without it — a monitor that cannot page is worse than none.
# Reuse the org webhook already in /etc/revhero/overlay-routing-healer.env (the same one the other dead-mans use).
SLACK_WEBHOOK=REPLACE_ME

# Optional knobs (defaults shown)
#TARGETS_FILE=/etc/revhero/staging-anon-probe.targets   # what to request; staging hosts only (enforced in code)
#LANE_LABEL=staging
#PROBE_VANTAGE=                # shown in every alert; defaults to the hostname. Set it to say WHERE this runs (see README).
#MAX_TIME=20                   # seconds per request
#RETRIES=1                     # extra tries on a timeout / 5xx / 429 / connection error
#BUDGET_SECS=420               # total time for the whole run; the rest are reported as not evaluated
#MIN_EVALUATED_PCT=50          # fewer evaluable probes than this => "could not evaluate" (kind failed)
#CONFIRM_RUNS=2                # consecutive "could not evaluate" runs before paging (daily runs: a 2-day delay on purpose)
#REMIND_HOURS=46               # re-alert interval for an UNCHANGED finding; a new or changed finding alerts at once
