# /etc/revhero/swarm-node-watch.env   (chmod 0600; install.sh writes a skeleton — secrets are NOT in this repo)
#
# REQUIRED: the check exits 2 (unit FAILED) without it — a monitor that cannot page is worse than none.
# Reuse the org webhook already in /etc/revhero/overlay-routing-healer.env. "REPLACE_ME" counts as unset.
SLACK_WEBHOOK=REPLACE_ME

# Shown in every message (which swarm this is).
LANE_LABEL=prod

# Optional: node names, exactly as `docker node ls` prints them, that MUST be in the swarm. One that is missing pages.
# (A node that is listed but Down/Drain/Pause pages without this; this only catches a node that vanished from the list.)
#EXPECTED_NODES=revhero-workers,revhero-web,vmi3162825

# Optional knobs (defaults shown)
#REMIND_HOURS=6            # re-alert interval for an UNCHANGED problem set
#RECOVER_RUNS=2            # consecutive clean runs before RECOVERED (the flap guard)
#BLIND_RUNS=2              # consecutive runs a blind spot (node list / journal unreadable) must last before it pages
#WAVE_THRESHOLD=3          # heartbeat-failure waves in the window that page a worker; 0 = switch the wave check (and its SSH) off
#WAVE_WINDOW_MINUTES=60
#WAVE_GAP_MINUTES=5        # failing minutes this close together are ONE wave
#WAVE_CLEAR_BELOW=1        # an alerted worker clears only when it has fewer waves than this in the window (1 = a clean window)
#REMOTE_TIMEOUT=30         # seconds per worker for the SSH + journal read
