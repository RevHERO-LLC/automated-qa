# /etc/revhero/upload-health-probe.env
# Which cloud-documents to probe. Use the STAGING host to probe staging.
CLOUD_DOCS_BASE=https://cloud-documents-service.revhero.io
UPLOAD_PROVIDER=aws
UPLOAD_FOLDER=health-probe
# Fail loud. Without this the probe still exits non-zero, but nobody sees it.
SLACK_WEBHOOK_DEPLOYS=
