# /etc/revhero/offsite-backup-deadman.env   (chmod 0600; install.sh writes a skeleton — secrets are NOT in this repo)
#
# REQUIRED: the check exits 2 (unit FAILED) without it — a dead-man that cannot page is worse than none.
# Reuse the org webhook already in /etc/revhero/overlay-routing-healer.env.
SLACK_WEBHOOK=REPLACE_ME

# READ-ONLY AWS identity for listing the backup prefix. The VPS4 backup key is WRITE-ONLY by design (an attacker on
# VPS4 can add objects but never read/list/delete them), so it cannot be used here. Create a separate IAM user with
# only s3:ListBucket on arn:aws:s3:::920373022094-database-backups (condition s3:prefix = postgres/*), store its key in
# /root/.aws/credentials under this profile name, and add the key to the credential-rotation runbook.
AWS_PROFILE=backup-deadman-ro

# Optional knobs (defaults shown)
#S3_BUCKET=920373022094-database-backups
#S3_PREFIX=postgres/prod/
#STALE_HOURS=26       # newest offsite object older than this => "stale" alert (nightly job runs ~02:15Z)
#CONFIRM_RUNS=2       # consecutive failed S3 reads before paging (a network blip must not page)
#REMIND_HOURS=12      # re-alert interval for an UNCHANGED problem
#LANE_LABEL=prod
