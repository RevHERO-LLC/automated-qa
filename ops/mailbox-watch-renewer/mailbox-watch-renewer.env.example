# Copy to /etc/revhero/mailbox-watch-renewer.env on VPS2 (chmod 600).
# SLACK_WEBHOOK is reused from /etc/revhero/overlay-routing-healer.env (deploy channel).
SLACK_WEBHOOK=https://hooks.slack.com/services/REDACTED
EMAIL_INGRESS_BASE=https://email-ingress.revhero.io
# #1057: the prod email-ingress INTERNAL_SERVICES_WEBHOOK_SECRET. Required before email-ingress sets
# INTERNAL_AUTH_ENFORCE=true (the refresh routes then reject calls without it). Never commit the value.
EMAIL_INGRESS_INTERNAL_SECRET=
