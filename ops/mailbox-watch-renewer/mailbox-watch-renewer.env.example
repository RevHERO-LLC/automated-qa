# Copy to /etc/revhero/mailbox-watch-renewer.env on VPS2 (chmod 600).
# SLACK_WEBHOOK is reused from /etc/revhero/overlay-routing-healer.env (deploy channel).
SLACK_WEBHOOK=https://hooks.slack.com/services/REDACTED
EMAIL_INGRESS_BASE=https://email-ingress.revhero.io
# #1057: the prod email-ingress INTERNAL_SERVICES_WEBHOOK_SECRET. Required before email-ingress sets
# INTERNAL_AUTH_ENFORCE=true (the refresh routes then reject calls without it). Never commit the value.
EMAIL_INGRESS_INTERNAL_SECRET=
# #1249 alerting knobs (all optional; defaults shown).
# ALERT_AFTER_FAILURES: consecutive failed runs per endpoint before the first Slack alert (one blip never pages).
#ALERT_AFTER_FAILURES=2
# REMIND_EVERY: re-alert (labelled reminder) every N further failed runs while an outage lasts (12 runs = 24 h at the 2h timer).
#REMIND_EVERY=12
# CURL_TIMEOUT: seconds per endpoint call.
#CURL_TIMEOUT=150
# After installing or changing SLACK_WEBHOOK, prove it works: TEST_ALERT=true /usr/local/bin/mailbox-watch-renewer.sh
