# /etc/revhero/analytics-alarm-deadman.env   (chmod 0600; install.sh writes a skeleton — secrets are NOT in this repo)
#
# REQUIRED: the check exits 2 (unit FAILED) without it — a dead-man that cannot page is worse than none.
# Reuse the org webhook already in /etc/revhero/overlay-routing-healer.env.
SLACK_WEBHOOK=REPLACE_ME

# Which analytics-service to watch. Prod default shown; the staging lane is internal-analytics.test.revhero.io.
ANALYTICS_BASE_URL=https://internal-analytics.revhero.io
LANE_LABEL=prod

# Credential for GET /v1/internal/alarms/heartbeat (X-Internal-Secret). PREFER the swarm service name: the secret
# is then read from the live service spec on every run, so a rotation can never leave a stale copy here (a stale
# credential is exactly what blinded email-drift-check for three days). Prod analytics = the Dokploy app
# "internal-analytics" (codename service below). Set ANALYTICS_INTERNAL_SECRET instead ONLY if the service is not
# on this swarm — and then add this file to the secret-rotation runbook.
ANALYTICS_SERVICE=app-connect-cross-platform-protocol-u4pgxl
#ANALYTICS_INTERNAL_SECRET=

# Optional knobs (defaults shown)
#STALE_MINUTES=30     # last_run_at older than this => "stale" alert
#CONFIRM_RUNS=2       # consecutive failed/unreadable calls before paging (a rolling deploy must not page)
#REMIND_HOURS=6       # re-alert interval for an UNCHANGED problem
