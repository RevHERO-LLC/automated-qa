[Unit]
Description=Dead-man check for the analytics-service alarm loop — Slack when its heartbeat is >30 min stale or unreadable
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/revhero/analytics-alarm-deadman.env
Environment=STATE_DIR=/var/lib/analytics-alarm-deadman
ExecStart=/usr/local/bin/check-alarm-heartbeat.sh
# A hung check is not a failure to systemd (oneshot has no default timeout) and would silently stop the
# dead-man — cap it so a hang becomes a FAILED unit instead of silence.
TimeoutStartSec=2min
StandardOutput=journal
StandardError=journal
User=root
